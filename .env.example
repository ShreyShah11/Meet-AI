# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/meetflow

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Gradio Diarization Endpoint
# Replace with your Colab public URL (e.g., https://xxxxx.gradio.live)
# This URL changes every 72 hours unless deployed permanently
GRADIO_ENDPOINT=https://your-colab-url.gradio.live

# LLM Provider (for extraction/summarization)
# Options: dummy, groq
LLM_PROVIDER=dummy
# For Groq, set LLM_PROVIDER=groq and provide either LLM_API_KEY or GROQ_API_KEY.
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=

# Bot attendee service
ATTENDEE_API_KEY=
ATTENDEE_API_BASE_URL=https://app.attendee.dev/api/v1
BOT_PORT=5001

# Gemini + Pinecone RAG
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
VECTOR_TOP_K=5
