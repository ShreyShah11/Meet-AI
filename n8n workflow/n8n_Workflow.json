    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originalItems = $('Is Jira Task?').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const lookupResult = items[i].json;\n  const originalData = originalItems[i]?.json || {};\n  \n  let accountId = null;\n  if (lookupResult?.accountId) {\n    accountId = lookupResult.accountId;\n  } else if (Array.isArray(lookupResult) && lookupResult[0]?.accountId) {\n    accountId = lookupResult[0].accountId;\n  }\n  \n  results.push({\n    json: {\n      ...originalData,\n      jiraAccountId: accountId\n    }\n  });\n}\n\nreturn results;"
      },
