    {
      "parameters": {
        "functionCode": "const input = items[0].json;\nconst body = input.body;\nconst tasks = body.tasks || [];\n\nconst output = [];\nfor (const task of tasks) {\n  output.push({\n    json: {\n      title: task.title,\n      description: task.description,\n      priority: task.priority,\n      assignee: task.assignee?.name || task.assignee || task.owner || 'Unassigned',\n      assigner: task.assigner?.name || 'Unknown',\n      \n      // FIX: Access fields directly, not via assigneeMapping\n      atlassianEmail: task.atlassianEmail || null,\n      googleEmail: task.googleEmail || null,\n      slackUserId: task.slackUserId || null,\n      slackMention: task.slackMention || null,\n      \n      dueDate: task.due_date || task.dueDate || null,\n      suggestedAction: task.suggested_schedule_action || 'manual',\n      confidence: task.confidence,\n      meetingId: body.meetingId,\n      confirmedAt: body.confirmedAt\n    }\n  });\n}\n\nreturn output;"
      },
