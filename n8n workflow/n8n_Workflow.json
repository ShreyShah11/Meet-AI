    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst tomorrow = new Date(today.getTime() + 86400000);\nconst dateStr = $input.item.json.dueDate || tomorrow.toISOString().slice(0,10);\n\nreturn {\n  json: {\n    ...($input.item.json),\n    calendarBody: JSON.stringify({\n      summary: $input.item.json.title || 'Meeting',\n      description: $input.item.json.description || '',\n      start: {\n        dateTime: dateStr + 'T09:00:00',\n        timeZone: 'Asia/Kolkata'\n      },\n      end: {\n        dateTime: dateStr + 'T09:30:00',\n        timeZone: 'Asia/Kolkata'\n      },\n      attendees: $input.item.json.googleEmail ? [{email: $input.item.json.googleEmail}] : []\n    })\n  }\n};"
      },
